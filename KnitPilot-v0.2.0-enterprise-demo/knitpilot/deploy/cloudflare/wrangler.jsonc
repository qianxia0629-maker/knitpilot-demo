{
  "name": "knitpilot-demo",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "KNITPILOT_REQUIRE_DEMO_TOKEN": "1"
  },
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__/**"]
  }
}
